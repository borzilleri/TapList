{
  "name": "taplist",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "The unofficial guide for the Washington Brewers Festival — a mobile-first, offline-capable PWA.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borzilleri/TapList.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx e2e/a11y.spec.ts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "pwa:icons": "pwa-assets-generator",
    "release": "./scripts/release.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.4",
    "@vite-pwa/assets-generator": "^1.0.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "playwright": "^1.60.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^4.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.14",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.7"
  }
}
